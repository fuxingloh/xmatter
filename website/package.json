{
  "name": "@workspace/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun --bun next build",
    "clean": "rm -rf .next",
    "dev": "bun --bun next dev",
    "lint": "eslint .",
    "start": "bun --bun next start"
  },
  "lint-staged": {
    "!(*.{js,jsx,ts,tsx})": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-packagejson"
    ],
    "printWidth": 120,
    "tailwindFunctions": [
      "clsx",
      "cva",
      "cx"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.3",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.4.0",
    "xmatter": "workspace:*"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@shikijs/rehype": "^3.22.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.1.18"
  }
}
